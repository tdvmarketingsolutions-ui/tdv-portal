# Public — safe to expose to the browser
# Find both in the Supabase dashboard: Project Settings -> API.
# Project ref: oyskgivdicvkqbdwrzyw (https://supabase.com/dashboard/project/oyskgivdicvkqbdwrzyw)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local dev: http://localhost:3000
# Production: https://tdv-client-portal.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never expose to the client. Used for admin actions
# (creating users, cross-tenant admin queries) via the service role.
# Supabase dashboard: Project Settings -> API -> service_role key (secret, not the anon key).
SUPABASE_SERVICE_ROLE_KEY=

# AI assistant (RAG) — server-only
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Embeddings provider for retrieval (used to search ai_documents). Without
# this, the assistant still answers — it just skips retrieval context.
# platform.openai.com -> API Keys
EMBEDDINGS_API_KEY=
AI_EMBEDDINGS_MODEL=text-embedding-3-large

# Email notifications — Resend API key (see lib/email/send.ts). Without
# this, in-app notifications still get created, just no email goes out.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=notificaties@tdv.be

# --- Where these live today (2026-08-11) ---
# Local:      .env.local in this project folder (never committed, see .gitignore).
# Production: Vercel project "tdv-client-portal" (team tdv-marketing-solutions) ->
#             Settings -> Environment Variables. Currently set there: the two
#             NEXT_PUBLIC_SUPABASE_* vars, NEXT_PUBLIC_SITE_URL, AI_EMBEDDINGS_MODEL,
#             EMAIL_FROM_ADDRESS, SUPABASE_SERVICE_ROLE_KEY. Still missing on Vercel:
#             ANTHROPIC_API_KEY, EMBEDDINGS_API_KEY, EMAIL_PROVIDER_API_KEY.
# Supabase auth redirect URLs (Authentication -> URL Configuration) are already
# set to the production URL above.
