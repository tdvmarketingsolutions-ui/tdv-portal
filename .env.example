# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never expose to the client. Used for admin actions
# (creating users, cross-tenant admin queries) via the service role.
SUPABASE_SERVICE_ROLE_KEY=

# AI assistant (RAG) — server-only
ANTHROPIC_API_KEY=
# Vector store: either Supabase pgvector (default, no extra var needed)
# or an external store — set this if you swap it out later.
AI_EMBEDDINGS_MODEL=text-embedding-3-large

# Email notifications (e.g. Resend, Postmark — pick one)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=notificaties@tdv.be
